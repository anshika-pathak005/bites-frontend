# Backend API (unchanged)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# --- Geocoding (new) -------------------------------------------------------
# Used only on the server, inside src/lib/geo/nominatim-server.ts.
# Nothing here is exposed to the browser.

# Nominatim requires a User-Agent that identifies the app and a way to contact
# whoever runs it. Put a real email or a URL here before deploying — requests
# without one get blocked.
NOMINATIM_CONTACT=you@yourdomain.com

# Point this at your own Nominatim instance when you have one. The public
# server allows 1 request/second and is not meant for production traffic.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Sent as the Referer on geocoding calls.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
